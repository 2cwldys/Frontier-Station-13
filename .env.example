# Copy this file to .env (repo root) and fill in real values.
# .env is gitignored -- unlike config/config.txt, it never gets committed,
# so secrets belong here instead.

# Optional GitHub personal access token (no scopes needed for a public repo).
# Raises SSgithub's API rate limit from 60 req/hr to 5000 req/hr.
# Leave unset/blank to poll unauthenticated.
GITHUB_TOKEN=

# Host port for the local Aurora DB container (docker-compose.yml's "db"
# service, config/dbconfig.txt). Leave blank/unset for the default, 3306 --
# only set this if 3306 is already taken on your machine, or you're running
# a second local instance side by side (e.g. a separate testing setup) and
# need it on a different port. Read by docker-compose.yml directly
# (${DB_PORT:-3306}) and by scripts/db_setup.ps1 / db_start.ps1 / db_restart.ps1
# so dbconfig.txt and the container's published port always agree.
# Example: DB_PORT=3306
DB_PORT=
