# Copy this file to .env and fill in real values -- see SETUP_GUIDE.txt.
# .env is already in the repo's .gitignore and will never be committed.

# Required
DISCORD_CLIENT_ID=1533582038379266218
SERVER_ADDR=
SERVER_PORT=

# Optional -- defaults are used if left blank/omitted
LARGE_IMAGE_KEY=fs13
LARGE_IMAGE_TEXT=Frontier Station 13
WINDOW_TITLE_MATCH=Frontier Station 13
POLL_INTERVAL_SECONDS=30
QUERY_TIMEOUT_SECONDS=5.0
RATE_LIMIT_BACKOFF_SECONDS=30

# Optional -- adds a "Join Discord" button below the presence text if set.
# Leave blank for no button.
DISCORD_INVITE_URL=https://discord.gg/58tEbcCkUP

# Optional -- small badge icon overlaid on the large image's corner (e.g.
# Discord's own icon mark, uploaded as its own Art Asset). Leave blank for
# no small image.
SMALL_IMAGE_KEY=discord_icon_small
SMALL_IMAGE_TEXT=Join the Discord
